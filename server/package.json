{
  "name": "ai-prompt-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/db/seed.js",
    "crawl": "node src/crawler/run.js",
    "crawl:prompthero": "node src/crawler/run.js --source prompthero",
